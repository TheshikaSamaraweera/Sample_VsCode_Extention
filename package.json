{
  "name": "code-health",
  "displayName": "Code Health Pro",
  "description": "Professional Code Health Monitoring Tool",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeHealthContainer",
          "title": "Code Health Pro",
          "icon": "$(heart-filled)"
        }
      ]
    },
    "views": {
      "codeHealthContainer": [
        {
          "id": "codeHealthSidebarView",
          "name": "Health Dashboard",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "code-health.helloWorld",
        "title": "Hello World",
        "icon": "$(star-full)"
      },
      {
        "command": "code-health.refresh",
        "title": "Refresh Dashboard",
        "icon": "$(sync)"
      },
      {
        "command": "code-health.checkHealth",
        "title": "Run Full Health Check",
        "icon": "$(pulse)"
      },
      {
        "command": "code-health.generateReport",
        "title": "Generate Report",
        "icon": "$(graph)"
      },
      {
        "command": "code-health.settings",
        "title": "Health Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "code-health.export",
        "title": "Export Data",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code-health.refresh",
          "when": "view == codeHealthSidebarView",
          "group": "navigation@1"
        },
        {
          "command": "code-health.checkHealth",
          "when": "view == codeHealthSidebarView",
          "group": "navigation@2"
        },
        {
          "command": "code-health.generateReport",
          "when": "view == codeHealthSidebarView",
          "group": "navigation@3"
        },
        {
          "command": "code-health.settings",
          "when": "view == codeHealthSidebarView",
          "group": "1_settings"
        }
      ],
      "view/item/context": [
        {
          "command": "code-health.export",
          "when": "view == codeHealthSidebarView",
          "group": "inline"
        }
      ]
    },
    "colors": [
      {
        "id": "codeHealth.errorColor",
        "description": "Color for health errors",
        "defaults": {
          "dark": "#ff6b6b",
          "light": "#e74c3c",
          "highContrast": "#ff0000"
        }
      },
      {
        "id": "codeHealth.warningColor", 
        "description": "Color for health warnings",
        "defaults": {
          "dark": "#feca57",
          "light": "#f39c12",
          "highContrast": "#ffff00"
        }
      },
      {
        "id": "codeHealth.successColor",
        "description": "Color for healthy status",
        "defaults": {
          "dark": "#48dbfb",
          "light": "#2ecc71",
          "highContrast": "#00ff00"
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.34.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}