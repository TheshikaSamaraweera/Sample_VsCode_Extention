{
  "name": "code-health",
  "displayName": "Code Health Analyzer",
  "description": "AI-powered code quality analyzer",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeHealthContainer",
          "title": "Code Health",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "codeHealthContainer": [
        {
          "id": "codeHealthSidebarView",
          "name": "Code Analyzer",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "code-health.analyzeFile",
        "title": "Analyze Current File",
        "icon": "$(search)"
      },
      {
        "command": "code-health.uploadAndAnalyze", 
        "title": "Upload & Analyze File",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "code-health.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code-health.analyzeFile",
          "when": "view == codeHealthSidebarView",
          "group": "navigation@1"
        },
        {
          "command": "code-health.uploadAndAnalyze",
          "when": "view == codeHealthSidebarView", 
          "group": "navigation@2"
        },
        {
          "command": "code-health.refresh",
          "when": "view == codeHealthSidebarView",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "code-health.analyzeFile",
          "group": "codeHealth",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.34.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}